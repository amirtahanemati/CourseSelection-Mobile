{
  "expo": {
    "name": "ابزار انتخاب واحد",
    "slug": "CourseSelection-Mobile",
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "32701751-969a-4393-bbeb-6ca70b0f3b29"
      }
    },
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "courseselectionmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amirtaha.courseselection"
    },
    "android": {
      "package": "com.amirtaha.courseselection",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#f5f7fa",
          "dark": {
            "backgroundColor": "#090a0f"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
